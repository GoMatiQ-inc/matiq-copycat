{
  "name": "matiq-copycat",
  "productName": "MatiQ Copycat",
  "version": "0.1.16",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --mac --arm64 --publish never",
    "tool:validate": "matiq-tool validate",
    "tool:pack": "matiq-tool pack --output tool.mqt",
    "tool:pack-app": "matiq-tool pack-app",
    "test": "node --test test/*.test.cjs",
    "test:desktop": "node scripts/desktop-test.cjs",
    "build:native": "node scripts/build-native.cjs",
    "build:extensions": "node scripts/build-extensions.cjs",
    "test:browser": "node scripts/browser-test.cjs",
    "test:native": "python3 scripts/test-native.py",
    "prepackage": "node scripts/build-native.cjs",
    "test:capture-native": "node scripts/capture-native-test.cjs",
    "test:native-app": "node scripts/native-app-test.cjs",
    "release:candidate": "node scripts/release.cjs",
    "verify:release": "node scripts/verify-release.cjs",
    "tool:package": "node scripts/package-tool.cjs",
    "test:packaged-project": "node scripts/packaged-project-test.cjs",
    "test:firefox": "node scripts/firefox-browser-test.cjs"
  },
  "dependencies": {
    "@matiq-solutions/runtime": "https://github.com/GoMatiQ-inc/matiq-solutions/releases/download/sdk-v0.1.3/matiq-solutions-runtime-0.1.3.tgz",
    "@matiq-solutions/sdk": "https://github.com/GoMatiQ-inc/matiq-solutions/releases/download/sdk-v0.1.3/matiq-solutions-sdk-0.1.3.tgz",
    "@matiq-solutions/shell": "https://github.com/GoMatiQ-inc/matiq-solutions/releases/download/sdk-v0.1.3/matiq-solutions-shell-0.1.3.tgz",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "js-yaml": "4.3.2"
  },
  "build": {
    "appId": "com.matiq.guides",
    "productName": "MatiQ Copycat",
    "icon": "node_modules/@matiq-solutions/shell/assets/app-icon.png",
    "mac": {
      "icon": "node_modules/@matiq-solutions/shell/assets/app-icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "minimumSystemVersion": "14.2",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Capture screenshots only for the workflow you explicitly record."
      }
    },
    "files": [
      "src/**/*",
      "matiq-tool.json",
      "package.json",
      "LICENSE",
      "NOTICE",
      "docs/*.md",
      "extension/identities.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "GoMatiQ-inc",
        "repo": "matiq-copycat"
      }
    ],
    "extraResources": [
      {
        "from": "native/guides-bridge",
        "to": "native/guides-bridge"
      },
      {
        "from": "native/guides-capture",
        "to": "native/guides-capture"
      }
    ]
  },
  "description": "Local illustrated workflow guides."
}
